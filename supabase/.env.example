# Secrets for Supabase Auth and Edge Functions.
# Local: copy to supabase/.env (read by `supabase start` and `supabase functions serve --env-file supabase/.env`).
# Production: set with `supabase secrets set NAME=value`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

# Google OAuth client (Supabase Google sign-in + Gmail API send/read)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (weekly digest emails) - optional
RESEND_API_KEY=
RESEND_FROM_EMAIL=
