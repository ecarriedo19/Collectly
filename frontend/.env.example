# Copy to frontend/.env.local and fill in values.

# Supabase project URL (local: http://localhost:54321)
REACT_APP_SUPABASE_URL=

# Supabase anon (public) key - safe for the browser, access is enforced by RLS
REACT_APP_SUPABASE_ANON_KEY=

# Google OAuth client ID used to start the Gmail connection flow
REACT_APP_GOOGLE_CLIENT_ID=
